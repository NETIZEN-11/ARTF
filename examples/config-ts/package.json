{
  "name": "ts-config-example",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "TypeScript configuration example for artef with dynamic schema generation",
  "scripts": {
    "eval": "NODE_OPTIONS=\"--import tsx\" artef eval -c artefconfig.ts",
    "eval-schema": "NODE_OPTIONS=\"--import tsx\" artef eval -c artefconfig-with-schema.ts",
    "view": "artef view"
  },
  "dependencies": {
    "openai": "^7.1.0",
    "tsx": "^4.23.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "artef": "latest"
  }
}
